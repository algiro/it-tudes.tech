# Copy to tools/deploy.local.env (git-ignored) and fill in your server's values.
# deploy.sh reads it locally and uploads it next to setup-server.sh on the server.

# ssh alias (from ~/.ssh/config in WSL) and the hostname the server must report,
# so a deploy never lands on the wrong machine.
SSH_HOST=my-server
EXPECTED_HOST=my-server-hostname

# Where releases live on the server; mounted read-only into the proxy at /srv/it-tudes.
REMOTE_BASE=/home/deploy/sites/it-tudes
REMOTE_SETUP=/home/deploy/sites/it-tudes-setup

# The nginx container that terminates HTTPS, and the folder with its docker-compose.yml
# and nginx config (used once by setup-server.sh).
CONTAINER=nginx
DOCKER_DIR=/home/deploy/docker
NGINX_CONF=nginx.conf
BACKUPS=/home/deploy/backups/it-tudes-setup

# Other apps behind the same proxy, checked after a deploy or setup: "scheme path expected-status".
OTHER_CHECKS="http /health 200
https /other-app/ 200"
